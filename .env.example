# Copy to .env.local (local) or set in your hosting provider's environment settings.

# Public site URL — used for canonical URLs, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.co.za

# Business contact details shown across the site.
# Until all three are set, placeholders are displayed and contact details are left out of structured data.
NEXT_PUBLIC_BUSINESS_PHONE=+27 00 000 0000
# International format, digits only (no +, spaces or leading 0), e.g. 27821234567
NEXT_PUBLIC_WHATSAPP_NUMBER=27000000000
NEXT_PUBLIC_BUSINESS_EMAIL=info@your-domain.co.za

# Quote form email delivery (https://resend.com). Without these, the form logs submissions
# in development and, in production, shows a WhatsApp/phone fallback instead of losing the lead.
RESEND_API_KEY=
# One or more recipients, comma-separated
QUOTE_TO_EMAIL=
# A sender address on a domain verified with Resend, e.g. "Hamile Engineering <quotes@your-domain.co.za>"
QUOTE_FROM_EMAIL=
